{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Records sounds on the server and exports them as lagless audio",
  "authors": [
    "RS256"
  ],
  "contact": {
    "sources": "https://github.com/RS-256/jukebox"
  },
  "license": "CC0-1.0",
  "icon": "assets/jukebox/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rs256.jukebox.JukeboxMod"
    ],
    "client": [
      "net.rs256.jukebox.client.JukeboxClient"
    ]
  },
  "mixins": [
    "jukebox.mixins.json",
    {
      "config": "jukeboxClient.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "${accesswidener}",
  "depends": {
    "fabricloader": "${fabricLoader}",
    "minecraft": "${minecraft}",
    "${fabricApiKey}": "${fabricAPI}"
  }
}